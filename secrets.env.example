# Copy to secrets.env and fill in. Never commit secrets.env.
#   chmod 600 secrets.env

# Plex Media Server. 127.0.0.1 is correct if the scripts run on the same machine as PMS.
PLEX_URL=http://127.0.0.1:32400
PLEX_TOKEN=

# Optional. Used when the Plex guide has no IMDb score. https://www.omdbapi.com/apikey.aspx
OMDB_KEY=

# Movie filters (plex-record-movies.py)
MIN_IMDB=7.0
ALWAYS_IMDB=8.0
MAX_PER_RUN=25
MIN_RUNTIME_MIN=80
MIN_YEAR=1970
MOVIES_SECTION_ID=
EPG_MOVIES_KEY=
HD_ONLY=1
MIN_BOX_OFFICE=50000000

# New-series catcher (plex-catch-series.py)
TV_SECTION_ID=
EPG_SHOWS_KEY=
SERIES_HD_ONLY=1
SERIES_MAX_PER_RUN=8
SERIES_MAX_PER_WEEK=8
SERIES_MIN_RUNTIME_MIN=20
SERIES_MAX_RUNTIME_MIN=130
SERIES_HORIZON_DAYS=14

# Required for plex-catch-series.py. Comma-separated HD call signs from your
# Plex Live TV guide. Append :rank to deprioritize (lower rank is preferred).
# Example (placeholder call signs — replace with yours):
# SERIES_MAJORS=WNBCDT,WABCDT,WCBSDT,WFOXDT,WCWDT:1,WPBSDT:2
SERIES_MAJORS=
