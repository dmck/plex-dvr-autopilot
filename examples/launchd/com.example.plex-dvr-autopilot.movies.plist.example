<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.example.plex-dvr-autopilot.movies</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/Users/YOUR_USERNAME/src/plex-dvr-autopilot/plex-record-movies.py</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>6</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>WorkingDirectory</key>
  <string>/Users/YOUR_USERNAME/src/plex-dvr-autopilot</string>
  <key>StandardOutPath</key>
  <string>/Users/YOUR_USERNAME/src/plex-dvr-autopilot/plex-record-movies.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/YOUR_USERNAME/src/plex-dvr-autopilot/plex-record-movies.log</string>
</dict>
</plist>
